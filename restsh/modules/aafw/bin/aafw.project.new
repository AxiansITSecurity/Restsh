#!/usr/bin/env bash

# SPDX-License-Identifier: GPL-3.0-or-later
# (c) Axians IT Security GmbH
# Jürgen Mang <juergen.mang@sec.axians.de>
# https://www.axians.de/security
# https://github.com/AxiansITSecurity/Restsh

# Shortdesc: Creates a GitLab project for automation.
# Desc:
# Creates a GitLab project for automation.

# Strict error handling
set -eEu -o pipefail

# Debug mode
[ -n "${RESTSH_DEBUG+x}" ] && set -x

if [ -z "${RESTSH_PATH+x}" ]
then
    echo "Script must be run in the restsh environment."
    exit 1
fi

if [ -z "${RESTSH_AAFW_GROUP+x}" ]
then
    export RESTSH_AAFW_GROUP="aafw"
    echo_warn "Variable RESTSH_AAFW_GROUP not set."
    echo_warn "Using default: $RESTSH_AAFW_GROUP"
fi
if [ -z "${RESTSH_AAFW_AS3SKELETON+x}" ]
then
    export RESTSH_AAFW_AS3SKELETON="${RESTSH_AAFW_GROUP}/as3skeleton"
    echo_warn "Variable RESTSH_AAFW_AS3SKELETON not set."
    echo_warn "Using default: $RESTSH_AAFW_AS3SKELETON"
fi
if [ -z "${RESTSH_AAFW_DOSKELETON+x}" ]
then
    export RESTSH_AAFW_DOSKELETON="${RESTSH_AAFW_GROUP}/doskeleton"
    echo_warn "Variable RESTSH_AAFW_DOSKELETON not set."
    echo_warn "Using default: $RESTSH_AAFW_DOSKELETON"
fi
if [ -z "${RESTSH_AAFW_WAFSKELETON+x}" ]
then
    export RESTSH_AAFW_WAFSKELETON="${RESTSH_AAFW_GROUP}/wafskeleton"
    echo_warn "Variable RESTSH_AAFW_WAFSKELETON not set."
    echo_warn "Using default: $RESTSH_AAFW_WAFSKELETON"
fi
if [ -z "${RESTSH_AAFW_F5UPDATESKELETON+x}" ]
then
    export RESTSH_AAFW_F5UPDATESKELETON="${RESTSH_AAFW_GROUP}/f5updateskeleton"
    echo_warn "Variable RESTSH_AAFW_F5UPDATESKELETON not set."
    echo_warn "Using default: $RESTSH_AAFW_F5UPDATESKELETON"
fi
if [ -z "${RESTSH_AAFW_PROJECT_SETTINGS+x}" ]
then
    export RESTSH_AAFW_PROJECT_SETTINGS="${RESTSH_PATH}/modules/aafw/templates/project_settings_default.json"
    echo_warn "Variable RESTSH_AAFW_PROJECT_SETTINGS not set."
    echo_warn "Using default: $RESTSH_AAFW_PROJECT_SETTINGS"
fi

# Get options
INIT_PROJECT=""
INIT_OPTS=()
PROTECTED_BRANCHES=()
ACCESS_LEVEL=(0 40)
SKELETON_PATH=""
CLM_TYPE=""
while getopts ':d:e:hi:l:p:s:t:' OPTION
do
    case "$OPTION" in
        d)
            if [ ! -d "$OPTARG" ]
            then
                echo_err "Parent folder $OPTARG does not exist."
                OPTION="invalid"
                break
            else
                INIT_OPTS+=("-d" "$OPTARG")
            fi
            ;;
        e) restsh.util.check.string "Project settings json file" "$OPTARG"; RESTSH_AAFW_PROJECT_SETTINGS="$OPTARG" ;;
        i) INIT_PROJECT=$OPTARG ;;
        l) mapfile -d, -t ACCESS_LEVEL < <(printf "%s" "$OPTARG") ;;
        p) mapfile -d, -t PROTECTED_BRANCHES < <(printf "%s" "$OPTARG") ;;
        s) restsh.util.check.string "Skeleton path" "$OPTARG"; SKELETON_PATH=$OPTARG ;;
        t) CLM_TYPE=$OPTARG ;;
        *) OPTION="invalid"; break ;;
    esac
done
shift "$((OPTIND -1))"

if [ "$OPTION" = "invalid" ] || [ -z "${1+x}" ]
then
    exec 1>&2
    _restsh.help.shortdesc.get "$0"
    echo "Usage: $(basename "$0") [options...] <project path>"
    echo "Options:"
    echo "    -d <folder>         Parent folder for cloned repository."
    echo "    -e <file>           Project settings json file."
    echo "                        Default: modules/aafw/templates/project_settings_default.json."
    echo "    -i <type>           Initialize repository for as3, cert, do, tasks, waf, f5update."
    echo "    -l <push,merge>     Access level for protected branches, default: Maintainer access for merge only."
    echo "    -s <skeleton path>  Skeleton path for initialization."
    echo "    -t <clm type>       CLM pipeline to use (only for type = cert, see aafw.project.init.cert -h for details)"
    echo "    -p <branches>       Comma separated list of branches to protect."
    echo ""
    echo "Access levels:"
    echo "    -  0: No access"
    echo "    - 30: Developer access"
    echo "    - 40: Maintainer access"
    echo "    - 60: Admin access"
    echo ""
    echo "GitLab skeletons paths:"
    echo "    - AS3:      $RESTSH_AAFW_AS3SKELETON"
    echo "    - DO:       $RESTSH_AAFW_DOSKELETON"
    echo "    - F5UPDATE: $RESTSH_AAFW_F5UPDATESKELETON"
    echo "    - WAF:      $RESTSH_AAFW_WAFSKELETON"
    exit 2
fi

restsh.util.check.string "project path" "$1"; PROJECT_PATH=$1
PROJECT_NAME="${PROJECT_PATH##*/}"
GROUP_NAME=${PROJECT_PATH%/*}

if [ ! -s "$RESTSH_AAFW_PROJECT_SETTINGS" ]
then
    echo_err "Default project settings file \"${RESTSH_AAFW_PROJECT_SETTINGS}\" not found."
    exit 1
fi

GROUP_ID=$(gitlab.group.get -r "$GROUP_NAME" | JQ -r ".id")
PROJECT_ID=$(gitlab.project.create -r "$GROUP_ID" "$PROJECT_NAME")

if [ -n "${PROTECTED_BRANCHES[*]}" ]
then
    for BRANCH in "${PROTECTED_BRANCHES[@]}"
    do
        gitlab.branch.protect.set "$PROJECT_ID" "$BRANCH" "${ACCESS_LEVEL[0]}" "${ACCESS_LEVEL[1]}" false > /dev/null
    done
fi

if ! RESULT=$(PUT "$GITLAB_API_PREFIX/projects/$PROJECT_ID" < "$RESTSH_AAFW_PROJECT_SETTINGS")
then
    echo_err "Failure setting project options for $PROJECT_ID"
    echo_err "$RESULT"
    exit 1
fi

if [ -n "$INIT_PROJECT" ]
then
    if [ -z "${RESTSH_AAFW_URI+x}" ] || [ -z "${RESTSH_AAFW_GROUP+x}" ]
    then
        echo_err "You must export RESTSH_AAFW_URI and RESTSH_AAFW_GROUP"
        exit 1
    fi

    CLONE_URI="${RESTSH_AAFW_URI}${PROJECT_PATH}.git"
    case "$INIT_PROJECT" in
        as3)
            if [ -z "$SKELETON_PATH" ]
            then
                if [ -n "${RESTSH_AAFW_AS3SKELETON+x}" ]
                then
                    SKELETON_PATH="$RESTSH_AAFW_AS3SKELETON"
                else
                    SKELETON_PATH="${RESTSH_AAFW_GROUP}/as3skeleton"
                fi
            fi
            aafw.project.init.as3 "${INIT_OPTS[@]}" "${RESTSH_AAFW_URI}${SKELETON_PATH}" "$CLONE_URI"
            ;;
        cert)
            [ -n "$CLM_TYPE" ] && INIT_OPTS+=("-t" "$CLM_TYPE")
            aafw.project.init.cert "${INIT_OPTS[@]}" "$CLONE_URI"
            ;;
        do)
            if [ -z "$SKELETON_PATH" ]
            then
                if [ -n "${RESTSH_AAFW_DOSKELETON+x}" ]
                then
                    SKELETON_PATH="$RESTSH_AAFW_DOSKELETON"
                else
                    SKELETON_PATH="${RESTSH_AAFW_GROUP}/doskeleton"
                fi
            fi
            gitlab.project.variable.batch -e "$PROJECT_PATH" "${RESTSH_PATH}/modules/aafw/templates/ci_variables_do.csv"
            aafw.project.init.do "${INIT_OPTS[@]}" "${RESTSH_AAFW_URI}${SKELETON_PATH}" "$CLONE_URI"
            ;;
        f5update)
            if [ -z "$SKELETON_PATH" ]
            then
                if [ -n "${RESTSH_AAFW_F5UPDATESKELETON+x}" ]
                then
                    SKELETON_PATH="$RESTSH_AAFW_F5UPDATESKELETON"
                else
                    SKELETON_PATH="${RESTSH_AAFW_GROUP}/f5updateskeleton"
                fi
            fi
            gitlab.project.variable.batch -e "$PROJECT_PATH" "${RESTSH_PATH}/modules/aafw/templates/ci_variables_f5update.csv"
            aafw.project.init.f5update "${INIT_OPTS[@]}" "${RESTSH_AAFW_URI}${SKELETON_PATH}" "$CLONE_URI"
            ;;
        tasks)
            gitlab.project.variable.batch -e "$PROJECT_PATH" "${RESTSH_PATH}/modules/aafw/templates/ci_variables_tasks.csv"
            aafw.project.init.tasks "${INIT_OPTS[@]}" "$CLONE_URI"
            ;;
        waf)
            if [ -z "$SKELETON_PATH" ]
            then
                if [ -n "${RESTSH_AAFW_WAFSKELETON+x}" ]
                then
                    SKELETON_PATH="$RESTSH_AAFW_WAFSKELETON"
                else
                    SKELETON_PATH="${RESTSH_AAFW_GROUP}/wafskeleton"
                fi
            fi
            aafw.project.init.waf "${INIT_OPTS[@]}" "${RESTSH_AAFW_URI}${SKELETON_PATH}" "$CLONE_URI"
            ;;
        *)
            echo_err "Unknown project type"
            exit 1
            ;;
    esac
fi
