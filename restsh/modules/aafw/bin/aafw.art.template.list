# Shortdesc: Lists all Application Ready Templates.
# Desc:
# Lists all Application Ready Templates.

# Strict error handling
set -eEu -o pipefail

# Debug mode
[ -n "${RESTSH_DEBUG+x}" ] && set -x

if [ -z "${RESTSH_PATH+x}" ]
then
    echo "Script must be run in the restsh environment."
    exit 1
fi

if [ -z "${RESTSH_AAFW_ART+x}" ]
then
    echo_err "Variable RESTSH_AAFW_ART is not defined in your configuration."
    exit 1
fi

# Get options
while getopts ':' OPTION
do
    case "$OPTION" in
        *) OPTION="invalid"; break ;;
    esac
done
shift "$((OPTIND -1))"

if [ "$OPTION" = "invalid" ] || [ $# -ne 0 ]
then
    exec 1>&2
    _restsh.help.shortdesc.get "$0"
    echo "Usage: $(basename "$0")"
    exit 2
fi

ART_ID=$(restsh.util.urlencode "$RESTSH_AAFW_ART")

GET "${GITLAB_API_PREFIX}/projects/${ART_ID}/repository/tree" \
    | JQ -r '.[] | select(.type == "tree") | .name'
