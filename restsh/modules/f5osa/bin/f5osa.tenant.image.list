# https://github.com/AxiansITSecurity/Restsh

# Shortdesc: Lists tenant images.
# Desc:
# Manages Lists tenant images.

# Strict error handling
set -eEu -o pipefail

# Debug mode
[ -n "${RESTSH_DEBUG+x}" ] && set -x

if [ -z "${RESTSH_PATH+x}" ]
then
    echo "Script must be run in the restsh environment."
    exit 1
fi

# Get options
RAW=0
while getopts ':r' OPTION
do
    case "$OPTION" in
        r) RAW=1 ;;
        *) OPTION="invalid"; break ;;
    esac
done
shift "$((OPTIND -1))"

if [ "$OPTION" == "invalid" ]
then
    exec 1>&2
    _restsh.help.desc.get "$0"
    echo "Usage: $(basename "$0") [options...]"
    echo "Options:"
    echo "    -r  Raw output."
    exit 2
fi

# Main
if [ "$RAW" -eq 1 ]
then
    GET "$F5OSA_API_PREFIX/data/f5-tenant-images:images"
else
    GET -r "$F5OSA_API_PREFIX/data/f5-tenant-images:images" \
        | JQ -r '."f5-tenant-images:images".image[] | [.name, .date, .size, .type, ."in-use", .status] | @tsv' \
        | COLUMN -o "|" -N "Name,Date,Size,Type,In Use,Status"
fi
