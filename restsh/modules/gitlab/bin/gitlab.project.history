# https://www.axians.de/security
# https://github.com/AxiansITSecurity/Restsh

# Shortdesc: Lists all project commits.
# Desc:
# Lists all project commits.

# Strict error handling
set -eEu -o pipefail

# Debug mode
[ -n "${RESTSH_DEBUG+x}" ] && set -x

if [ -z "${RESTSH_PATH+x}" ]
then
    echo "Script must be run in the restsh environment."
    exit 1
fi

# Get options
RAW=0
while getopts ':r' OPTION
do
    case "$OPTION" in
        r) RAW=1 ;;
        *) OPTION="invalid"; break ;;
    esac
done
shift "$((OPTIND -1))"

if [ "$OPTION" = "invalid" ] || [ $# -lt 2 ]
then
    exec 1>&2
    _restsh.help.desc.get "$0"
    echo "Usage: $(basename "$0") [options...] <project> <branch> [<page>]"
    echo "Options:"
    echo "    -r  Raw output."
    exit 2
fi

restsh.util.check.string "project" "$1"; PROJECT=$1
restsh.util.check.isnumber "$PROJECT" || PROJECT=$(restsh.util.urlencode "$PROJECT")
restsh.util.check.string "branch" "$2"; BRANCH=$2

PAGE=$GITLAB_PAGE
if [ -n "${3+x}" ]
then
    PAGE=$3
fi

if [ "$RAW" -eq 1 ]
then
    gitlab.util.list "$GITLAB_API_PREFIX/projects/$PROJECT/repository/commits?ref_name=$BRANCH" "$PAGE" "${GITLAB_PER_PAGE}"
else
    gitlab.util.list "$GITLAB_API_PREFIX/projects/$PROJECT/repository/commits?ref_name=$BRANCH" "$PAGE" "${GITLAB_PER_PAGE}" \
        | JQ -r '.[] | [.committed_date, .short_id, .author_name, .title] | @tsv' \
        | COLUMN -o "|" -N "date,id,author,title"
fi
