# Shortdesc: Retrieves a file from a GitLab repository.
# Desc:
# Retrieves a file from a GitLab repository.

# Strict error handling
set -eEu -o pipefail

# Debug mode
[ -n "${RESTSH_DEBUG+x}" ] && set -x

if [ -z "${RESTSH_PATH+x}" ]
then
    echo "Script must be run in the restsh environment."
    exit 1
fi

while getopts ':h' OPTION
do
    case "$OPTION" in
        *) OPTION="invalid"; break ;;
    esac
done
shift "$((OPTIND -1))"

if [ "$OPTION" = "invalid" ] || [ $# -ne 4 ]
then
    exec 1>&2
    _restsh.help.desc.get "$0"
    echo "Usage: $(basename "$0") <project> <branch> <remote filename> <local filename>"
    exit 2
fi

restsh.util.check.string "project" "$1"; PROJECT=$1
restsh.util.check.string "branch" "$2"; BRANCH=$2
restsh.util.check.filename "remote filename" "$3"; REMOTE_FILE=$(restsh.util.urlencode "$3")
restsh.util.check.filename "local filename" "$4"; LOCAL_FILE=$4

restsh.util.check.isnumber "$PROJECT" || PROJECT=$(restsh.util.urlencode "$PROJECT")

GET "$GITLAB_API_PREFIX/projects/${PROJECT}/repository/files/${REMOTE_FILE}?ref=$BRANCH" \
    | JQ -r '.content' | base64 -d > "${LOCAL_FILE}"
