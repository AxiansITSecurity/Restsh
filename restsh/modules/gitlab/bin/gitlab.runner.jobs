# https://github.com/AxiansITSecurity/Restsh

# Shortdesc: Lists jobs for a runner.
# Desc:
# Lists jobs for a runner.

# Strict error handling
set -eEu -o pipefail

# Debug mode
[ -n "${RESTSH_DEBUG+x}" ] && set -x

if [ -z "${RESTSH_PATH+x}" ]
then
    echo "Script must be run in the restsh environment."
    exit 1
fi

# Get options
RAW=0
while getopts ':r' OPTION
do
    case "$OPTION" in
        r) RAW=1 ;;
        *) OPTION="invalid"; break ;;
    esac
done
shift "$((OPTIND -1))"

if [ $# -lt 1 ] || [ "$OPTION" = "invalid" ]
then
    exec 1>&2
    _restsh.help.desc.get "$0"
    echo "Usage: $(basename "$0") [options...] <runner id> [<page>]"
    echo "Options:"
    echo "    -r  Raw output."
    exit 2
fi
restsh.util.check.uint "runner id" "$1"; RUNNER_ID=$1

PAGE=$GITLAB_PAGE
if [ -n "${2+x}" ]
then
    restsh.util.check.uint "page" "$2"; PAGE=$2
fi

if [ "$RAW" -eq 1 ]
then
    gitlab.util.list "$GITLAB_API_PREFIX/runners/$RUNNER_ID/jobs" "$PAGE" "${GITLAB_PER_PAGE}"
else
    gitlab.util.list "$GITLAB_API_PREFIX/runners/$RUNNER_ID/jobs" "$PAGE" "${GITLAB_PER_PAGE}" \
        | JQ -r '.[] | [.id, .project.path_with_namespace, .status, .started_at] | @tsv' \
        | COLUMN -o "|" -N "id,project,status,started_at"
fi
