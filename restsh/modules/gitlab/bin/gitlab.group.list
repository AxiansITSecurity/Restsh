# https://github.com/AxiansITSecurity/Restsh

# Shortdesc: Lists all groups.
# Desc:
# Lists all groups.

# Strict error handling
set -eEu -o pipefail

# Debug mode
[ -n "${RESTSH_DEBUG+x}" ] && set -x

if [ -z "${RESTSH_PATH+x}" ]
then
    echo "Script must be run in the restsh environment."
    exit 1
fi

# Get options
RAW=0
while getopts ':r' OPTION
do
    case "$OPTION" in
        r) RAW=1 ;;
        *) OPTION="invalid"; break ;;
    esac
done
shift "$((OPTIND -1))"

if [ "$OPTION" = "invalid" ]
then
    exec 1>&2
    _restsh.help.desc.get "$0"
    echo "Usage: $(basename "$0") [options...] [<page>]"
    echo "Options:"
    echo "    -r  Raw output."
    exit 2
fi

PAGE=$GITLAB_PAGE
if [ -n "${1+x}" ]
then
    restsh.util.check.uint "page" "$1"; PAGE=$1
fi

if [ "$RAW" -eq 1 ]
then
    gitlab.util.list "$GITLAB_API_PREFIX/groups" "$PAGE" "${GITLAB_PER_PAGE}"
else
    gitlab.util.list "$GITLAB_API_PREFIX/groups" "$PAGE" "${GITLAB_PER_PAGE}" \
        | JQ -r '.[] | [.id, .full_path] | @tsv' \
        | COLUMN -o "|" -N "id,full_path"
fi
