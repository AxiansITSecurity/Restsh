# https://github.com/AxiansITSecurity/Restsh

# Shortdesc: Lists all project members.
# Desc:
# Lists all project members.

# Strict error handling
set -eEu -o pipefail

# Debug mode
[ -n "${RESTSH_DEBUG+x}" ] && set -x

if [ -z "${RESTSH_PATH+x}" ]
then
    echo "Script must be run in the restsh environment."
    exit 1
fi

# Get options
DIRECT="/all"
RAW=0
while getopts ':dr' OPTION
do
    case "$OPTION" in
        d) DIRECT="" ;;
        r) RAW=1 ;;
        *) OPTION="invalid"; break ;;
    esac
done
shift "$((OPTIND -1))"

if [ -z "${1+x}" ] || [ "$OPTION" = "invalid" ]
then
    exec 1>&2
    _restsh.help.desc.get "$0"
    echo "Usage: $(basename "$0") [options...] <project> [<page>]"
    echo "Options:"
    echo "    -d  Show only direct members"
    echo "    -r  Raw output."
    exit 2
fi

restsh.util.check.string "project" "$1"; PROJECT=$1
restsh.util.check.isnumber "$PROJECT" || PROJECT=$(restsh.util.urlencode "$PROJECT")

PAGE=$GITLAB_PAGE
if [ -n "${2+x}" ]
then
    restsh.util.check.uint "page" "$2"; PAGE=$2
fi

if [ "$RAW" -eq 1 ]
then
    gitlab.util.list "$GITLAB_API_PREFIX/projects/$PROJECT/members${DIRECT}" "$PAGE" "${GITLAB_PER_PAGE}"
else
    gitlab.util.list "$GITLAB_API_PREFIX/projects/$PROJECT/members${DIRECT}" "$PAGE" "${GITLAB_PER_PAGE}" \
        | JQ -r '.[] | [.id,.username, .access_level] | @tsv' \
        | COLUMN -o "|" -N "id,username,access_level"
fi
