# https://github.com/AxiansITSecurity/Restsh

# Shortdesc: Creates an empty project.
# Desc:
# Creates an empty project.

# Strict error handling
set -eEu -o pipefail

# Debug mode
[ -n "${RESTSH_DEBUG+x}" ] && set -x

if [ -z "${RESTSH_PATH+x}" ]
then
    echo "Script must be run in the restsh environment."
    exit 1
fi

# Get options
RAW=0
BRANCH="master"
if [ -z "${GITLAB_PROJECT_SETTINGS+x}" ]
then
    PROJECT_SETTINGS="${RESTSH_PATH}/modules/gitlab/templates/project_settings_default.json"
else
    PROJECT_SETTINGS="$GITLAB_PROJECT_SETTINGS"
fi

while getopts ':b:e:r' OPTION
do
    case "$OPTION" in
        b) restsh.util.check.string "branch" "$OPTARG"; BRANCH=$OPTARG ;;
        e) restsh.util.check.string "Project settings json file" "$OPTARG"; PROJECT_SETTINGS="$OPTARG" ;;
        r) RAW=1 ;;
        *) OPTION="invalid"; break ;;
    esac
done
shift "$((OPTIND -1))"

if [ $# -ne 2 ] || [ "$OPTION" = "invalid" ]
then
    exec 1>&2
    _restsh.help.desc.get "$0"
    echo "Usage: $(basename "$0") [options...] <namespace id> <name>"
    echo "Options:"
    echo "    -b <branch>  Default branch, default: master"
    echo "    -e <file>    Project settings json file."
    echo "                 Default: modules/gitlab/templates/project_settings_default.json."
    echo "    -r           Raw output."
    exit 2
fi

restsh.util.check.string "namespace id" "$1"; NAMESPACE_ID=$1
restsh.util.check.string "name" "$2"; NAME=$2

restsh.util.check.isnumber "$NAMESPACE_ID" || NAMESPACE_ID=$(gitlab.group.id "$NAMESPACE_ID")

if RESULT=$(JQ -n --arg name "$NAME" \
    --arg branch "$BRANCH" \
    --argjson namespace_id "$NAMESPACE_ID" \
    '{
        "name": $name,
        "namespace_id": $namespace_id,
        "default_branch": $branch
    }' | POST -r "$GITLAB_API_PREFIX/projects")
then
    PROJECT_ID=$(JQ -r ".id" <<< "$RESULT")
    if [ "$RAW" -eq 1 ]
    then
        echo "$PROJECT_ID"
    else
        echo_ok "Empty project created with id $PROJECT_ID"
    fi
    # Default project settings
    PUT "$GITLAB_API_PREFIX/projects/$PROJECT_ID" < "$PROJECT_SETTINGS" > /dev/null
    exit 0
fi

echo_err "Failure creating project."
exit 1
