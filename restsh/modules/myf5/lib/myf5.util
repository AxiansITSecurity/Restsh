# Shortdesc: Gets the bearer token from myF5 OAuth Authorization Server.
# Desc:
# Gets the bearer token from myF5 OAuth Authorization Server.
# Define MYF5_CLIENTID and MYF5_SECRET variables.

# Strict error handling
set -uo pipefail

# Debug mode
[ -n "${RESTSH_DEBUG+x}" ] && set -x

# Sets the RESTSH_HOST for the download endpoint
myf5.endpoint.downloads() {
    if [ "$RESTSH_HOST" != "api.software.downloads.f5.com" ]
    then
        export RESTSH_HOST="api.software.downloads.f5.com"
        restsh.init.setresturl
    fi
}

export -f myf5.endpoint.downloads
