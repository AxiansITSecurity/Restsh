# https://www.axians.de/security
# https://github.com/AxiansITSecurity/Restsh

# Shortdesc: Creates a SNMPv3 user.
# Desc:
# Creates a SNMPv3 user.

# Strict error handling
set -eEu -o pipefail

# Debug mode
[ -n "${RESTSH_DEBUG+x}" ] && set -x

if [ -z "${RESTSH_PATH+x}" ]
then
    echo "Script must be run in the restsh environment."
    exit 1
fi

ACCESS="ro"
AUTHPROTO="sha256"
PRIVPROTO="aes256"
OID=".1"

while getopts ':a:ho:p:u:' OPTION
do
    case "$OPTION" in
        a) restsh.util.check.string "Access" "$OPTARG"; ACCESS=$OPTARG ;;
        o) restsh.util.check.string "OID" "$OPTARG"; OID=$OPTARG ;;
        p) restsh.util.check.string "Privacy" "$OPTARG"; PRIVPROTO=$OPTARG ;;
        u) restsh.util.check.string "Authentication" "$OPTARG"; AUTHPROTO=$OPTARG ;;
        *) OPTION="invalid"; break ;;
    esac
done
shift "$((OPTIND -1))"

if [ "$OPTION" = "invalid" ] || [ $# -ne 3 ]
then
    exec 1>&2
    _restsh.help.desc.get "$0"
    echo "Usage: $(basename "$0") [options..] <username> <auth pass> <priv pass>"
    echo "Options:"
    echo "    -a <access>      Valid values: ro (default), rw"
    echo "    -o <oid>         Allowed OID, default: .1"
    echo "    -p <priv proto>  Privacy protocol: aes, aes192, aes192c, aes256 (default), aes256c, des"
    echo "    -u <auth proto>  Authentication protocol: sha, sha256 (default), sha512, md5"
    exit 2
fi

restsh.util.check.string "username" "$1"; USERNAME=$1
AUTHPASS=$2
PRIVPASS=$3

JQ -n --arg username "$USERNAME" \
    --arg access "$ACCESS" \
    --arg authpass "$AUTHPASS" \
    --arg authproto "$AUTHPROTO" \
    --arg privpass "$PRIVPASS" \
    --arg privproto "$PRIVPROTO" \
    --arg oid "$OID" \
    '{
      "username": $username,
      "access": $access,
      "authPassword": $authpass,
      "authProtocol": $authproto,
      "privacyPassword": $privpass,
      "privacyProtocol": $privproto,
      "securityLevel": "auth-privacy",
      "oidSubset": $oid
    }' \
    | POST "/mgmt/tm/sys/snmp/users/$USERNAME"
