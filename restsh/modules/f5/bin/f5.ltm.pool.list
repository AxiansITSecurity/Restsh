# https://www.axians.de/security
# https://github.com/AxiansITSecurity/Restsh

# Shortdesc: Lists Pools.
# Desc:
# Lists Pools.

# Strict error handling
set -eEu -o pipefail

# Debug mode
[ -n "${RESTSH_DEBUG+x}" ] && set -x

if [ -z "${RESTSH_PATH+x}" ]
then
  echo "Script must be run in the restsh environment."
  exit 1
fi

# Get options
RAW=0
IPS=0
while getopts ':ir' OPTION
do
    case "$OPTION" in
        i) IPS=1 ;;
        r) RAW=1 ;;
        *) OPTION="invalid"; break ;;
    esac
done
shift "$((OPTIND -1))"

if [ "$OPTION" = "invalid" ]
then
    exec 1>&2
    _restsh.help.desc.get "$0"
    echo "Usage: $(basename "$0") [options...]"
    echo "Options:"
    echo "    -i  Print member IPs."
    echo "    -r  Raw output."
    exit 2
fi

if [ "$RAW" -eq 1 ]
then
    GET "/mgmt/tm/ltm/pool?expandSubcollections=true"
else
    while IFS=$'\t' read -r POOL MEMBERS_NAME MEMBERS_IP
    do
        IFS=',' read -ra NAME_ARRAY <<< "$MEMBERS_NAME"
        IFS=',' read -ra IP_ARRAY <<< "$MEMBERS_IP"
        if [ "$IPS" -eq 1 ]
        then
            COUNTER=0
            for MEMBER in "${NAME_ARRAY[@]}"
            do
                PORT="${MEMBER##*:}"
                IP_ARRAY[COUNTER]="${IP_ARRAY[${COUNTER}]}:${PORT}"
                COUNTER=$((COUNTER+1))
            done
            MEMBERS=$(restsh.util.array.string -s ", " "${IP_ARRAY[@]}")
        else
            MEMBERS=$(restsh.util.array.string -s ", " "${NAME_ARRAY[@]}")
        fi
        printf "%s\t%s\n" "$POOL" "$MEMBERS"
    done < <(GET "/mgmt/tm/ltm/pool?expandSubcollections=true" | JQ -r '.items[] | [.fullPath,([.membersReference.items[].name] | join(",")), ([.membersReference.items[].address] | join(","))] | @tsv') \
        | COLUMN -o "|" -N "Full Path,Members"
fi
