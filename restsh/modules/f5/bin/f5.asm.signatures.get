# Shortdesc: Gets a signature by its SignatureID.
# Desc:
# Gets a signature by its SignatureID.

# Strict error handling
set -eEu -o pipefail

# Debug mode
[ -n "${RESTSH_DEBUG+x}" ] && set -x

if [ -z "${RESTSH_PATH+x}" ]
then
    echo "Script must be run in the restsh environment."
    exit 1
fi

# Get options
while getopts ':' OPTION
do
    case "$OPTION" in
        *) OPTION="invalid"; break ;;
    esac
done
shift "$((OPTIND -1))"

if [ "$OPTION" == "invalid" ]
then
    exec 1>&2
    _restsh.help.desc.get "$0"
    echo "Usage: $(basename "$0") <signatureId>"
    exit 2
fi

restsh.util.check.uint "signatureId" "$1"; SIGNATURE_ID=$1

FILTER=$(restsh.util.urlencode "signatureId eq ${SIGNATURE_ID}")
FILTER="?\$filter=${FILTER}"

# Main
GET "/mgmt/tm/asm/signatures${FILTER}"
