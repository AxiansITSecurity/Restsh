# https://www.axians.de/security
# https://github.com/AxiansITSecurity/Restsh

# Shortdesc: Lists all signatures.
# Desc:
# Lists all signatures.

# Strict error handling
set -eEu -o pipefail

# Debug mode
[ -n "${RESTSH_DEBUG+x}" ] && set -x

if [ -z "${RESTSH_PATH+x}" ]
then
    echo "Script must be run in the restsh environment."
    exit 1
fi

# Get options
RAW=0
FILTER=""
FILTER_JQ=""
while getopts ':ri:n:' OPTION
do
    case "$OPTION" in
        i) restsh.util.check.uint "signatureId" "$OPTARG"; FILTER="signatureId eq ${OPTARG}" ;;
        n) restsh.util.check.string "string" "$OPTARG"; FILTER_JQ="| select(.name | contains(\"${OPTARG}\"))" ;;
        r) RAW=1 ;;
        *) OPTION="invalid"; break ;;
    esac
done
shift "$((OPTIND -1))"

if [ "$OPTION" == "invalid" ]
then
    exec 1>&2
    _restsh.help.desc.get "$0"
    echo "Usage: $(basename "$0") [searchfilter]"
    echo "Options:"
    echo "    -i <signature id>  List signature with given id."
    echo "    -n <string>        List signatures with contains the strint in its name"
    echo "    -r  Raw output."
    exit 2
fi

if [ -n "$FILTER" ]
then
    FILTER=$(restsh.util.urlencode "$FILTER")
    FILTER="&\$filter=${FILTER}"
fi

# Main
if [ "$RAW" -eq 1 ]
then
    GET "/mgmt/tm/asm/signatures?\$select=id,signatureId,name,accuracy,risk${FILTER}" \
        | JQ -r ".items[] ${FILTER_JQ} | [.id,.signatureId, .name, .accuracy, .risk]"
else
    GET "/mgmt/tm/asm/signatures?\$select=id,signatureId,name,accuracy,risk${FILTER}" \
        | JQ -r ".items[] ${FILTER_JQ} | [.id,.signatureId, .name, .accuracy, .risk] | @tsv" \
        | COLUMN -o "|" -N "Id,SignatureId,Name,Accuracy,Risk"
fi
