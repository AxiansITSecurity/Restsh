# Shortdesc: Triggers a bundle manager update.
# Desc:
# Triggers the bundle manager to update the CA bundle.
# Confirm the operation completed successfully by validating the managed bundle's .lastUpdateTime.
# e.g. f5.cert.get /Common/ca-bundle.crt | JQ -r '.lastUpdateTime'

# Strict error handling
set -eEu -o pipefail

# Debug mode
[ -n "${RESTSH_DEBUG+x}" ] && set -x

if [ -z "${RESTSH_PATH+x}" ]
then
    echo "Script must be run in the restsh environment."
    exit 1
fi

# Get options
WAIT=0
while getopts ':w' OPTION
do
    case "$OPTION" in
        w) WAIT=1 ;;
        *) OPTION="invalid"; break ;;
    esac
done
shift "$((OPTIND -1))"

if [ $# -ne 1 ] || [ "$OPTION" = "invalid" ]
then
    exec 1>&2
    _restsh.help.shortdesc.get "$0"
    echo "Usage: $(basename "$0") <bundle>"
    echo ""
    _restsh.help.desc.get "$0"
    exit 2
fi

restsh.util.check.string "bundle" "$1"; BUNDLE=${1//\//\~}

LAST_UPDATE_TIME=$(f5.cert.get "${BUNDLE}.crt" | JQ -r '.lastUpdateTime')

PATCH "/mgmt/tm/sys/crypto/ca-bundle-manager/${BUNDLE}" <<< '{"updateNow": "yes"}'

if [ "$WAIT" -eq 1 ]
then
    sleep 2
    UPDATE_TIME=$(f5.cert.get "${BUNDLE}.crt" | JQ -r '.lastUpdateTime')
    COUNTER=0
    while [ "$LAST_UPDATE_TIME" = "$UPDATE_TIME" ]
    do
        sleep 2
        UPDATE_TIME=$(f5.cert.get "${BUNDLE}.crt" | JQ -r '.lastUpdateTime')
        COUNTER=$((COUNTER+1))
        if [ "$COUNTER" -eq 30 ]
        then
            echo_err "Failure updating bundle"
            exit 1
        fi
    done
fi
