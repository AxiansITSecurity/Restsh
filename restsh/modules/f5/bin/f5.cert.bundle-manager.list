# Shortdesc: Lists all bundle manager entries.
# Desc:
# Lists all bundle manager entries.

# Strict error handling
set -eEu -o pipefail

# Debug mode
[ -n "${RESTSH_DEBUG+x}" ] && set -x

if [ -z "${RESTSH_PATH+x}" ]
then
    echo "Script must be run in the restsh environment."
    exit 1
fi

# Get options
RAW=0
while getopts ':r' OPTION
do
    case "$OPTION" in
        r) RAW=1 ;;
        *) OPTION="invalid"; break ;;
    esac
done
shift "$((OPTIND -1))"

if [ "$OPTION" = "invalid" ]
then
    exec 1>&2
    _restsh.help.desc.get "$0"
    echo "Usage: $(basename "$0") [options...]"
    echo "Options:"
    echo "    -r  Raw output."
    exit 2
fi

if [ "$RAW" -eq 1 ]
then
    GET "/mgmt/tm/sys/crypto/ca-bundle-manager"
else
    {
        while IFS=$'\t' read -r CSR NAME
        do
            printf "%s\t%s\n" "$CSR" "$NAME"
        done < <(GET -r "/mgmt/tm/sys/crypto/ca-bundle-manager" \
            | JQ -r '.items[] | [.fullPath, .updateInterval, (.includeUrl | join(","))] | @tsv')
    } | COLUMN -o "|" -N "fullPath,updateInterval,includeUrl"
fi