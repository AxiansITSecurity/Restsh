# https://github.com/AxiansITSecurity/Restsh

# Shortdesc: Modifies a pool from a declaration.
# Desc:
# Modifies a pool from a declaration.

# Strict error handling
set -eEu -o pipefail

# Debug mode
[ -n "${RESTSH_DEBUG+x}" ] && set -x

if [ -z "${RESTSH_PATH+x}" ]
then
  echo "Script must be run in the restsh environment."
  exit 1
fi

# Get options
DEFAULTS=""
while getopts ':d:hs:' OPTION
do
    case "$OPTION" in
        d) DEFAULTS=$OPTARG ;;
        s) restsh.util.declare.var "$OPTARG" ;;
        *) OPTION="invalid"; break ;;
    esac
done
shift "$((OPTIND -1))"

if [ "$OPTION" = "invalid" ] || [ $# -ne 2 ]
then
    exec 1>&2
    _restsh.help.desc.get "$0"
    echo "Usage: $(basename "$0") [options...] <pool_name> <json declaration file>"
    echo "Options:"
    echo "    -d <file>         File to read variables from"
    echo "    -s \"VAR=VALUE\"  Set a variable for template processing"
    exit 2
fi

restsh.util.check.string "pool_name" "$1"; POOL=$1
restsh.util.check.string "json declaration file" "$2"; DECLARATION=$2

# Include mustache
. "${RESTSH_PATH}/dist/mo/mo"
. "${RESTSH_PATH}/lib/mo/mo.functions"

MO_OPTIONS=()
if [ -n "$DEFAULTS" ]
then
    if [ ! -f "$DEFAULTS" ]
    then
        echo_err "Variables file not found."
        exit 1
    fi
    MO_OPTIONS+=("-s=""$DEFAULTS")
fi

$RESTSH_MO "${MO_OPTIONS[@]}" -- "$DECLARATION" \
    | PATCH "/mgmt/tm/ltm/pool/${POOL//\//\~}"
