# https://www.axians.de/security
# https://github.com/AxiansITSecurity/Restsh

# Shortdesc: Clones a pool.
# Desc:
# Clones a pool.

# Strict error handling
set -eEu -o pipefail

# Debug mode
[ -n "${RESTSH_DEBUG+x}" ] && set -x

if [ -z "${RESTSH_PATH+x}" ]
then
  echo "Script must be run in the restsh environment."
  exit 1
fi

# Get options
while getopts ':' OPTION
do
    case "$OPTION" in
        *) OPTION="invalid"; break ;;
    esac
done
shift "$((OPTIND -1))"

if [ "$OPTION" = "invalid" ] || [ $# -ne 2 ]
then
    exec 1>&2
    _restsh.help.desc.get "$0"
    echo "Usage: $(basename "$0") <src_pool_name> <dst_pool_name>"
    exit 2
fi

restsh.util.check.string "src_pool_name" "$1"; SRC_POOL=$1
restsh.util.check.string "dst_pool_name" "$2"; DST_POOL=$2

#shellcheck disable=SC2034
IFS=, read -r SRC_PARTITION SRC_SUBPATH SRC_NAME < <(f5.common.fullPathSplit2 "$SRC_POOL")
IFS=, read -r DST_PARTITION DST_SUBPATH DST_NAME < <(f5.common.fullPathSplit2 "$DST_POOL")

if [ "${SRC_PARTITION}/${SRC_SUBPATH}" != "${DST_PARTITION}/${DST_SUBPATH}" ]
then
    echo_err "Source and destination pool must be in the same path."
    exit 1
fi

trap 'rm -rf -- "${RESTSH_TMP}/pool.json"' EXIT

GET -r "/mgmt/tm/ltm/pool/${SRC_POOL//\//\~}?expandSubcollections=true" \
    | JQ 'del(.name, .generation, .link, .selfLink, .membersReference.link, .membersReference.items[].selfLink, .membersReference.items[].state, .membersReference.items[].generation)' \
    | JQ ".fullPath = \"$DST_POOL\"" \
    | JQ ".name = \"$DST_NAME\"" \
    | JQ "del(..|select(.session? == \"monitor-enabled\"))" \
    | JQ "del(..|select(.session? == \"monitor-disabled\"))" \
    > "${RESTSH_TMP}/pool.json"

POST "/mgmt/tm/ltm/pool" < "${RESTSH_TMP}/pool.json"
