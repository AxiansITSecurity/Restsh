# https://github.com/AxiansITSecurity/Restsh

# Shortdesc: Creates a Route Domain.
# Desc:
# Creates a Route Domain.

# Strict error handling
set -eEu -o pipefail

# Debug mode
[ -n "${RESTSH_DEBUG+x}" ] && set -x

if [ -z "${RESTSH_PATH+x}" ]
then
  echo "Script must be run in the restsh environment."
  exit 1
fi

# Get options
STRICT="enabled"
PARENT=""
while getopts ':np:' OPTION
do
    case "$OPTION" in
        n) STRICT="disabled" ;;
        p) restsh.util.check.string "Parent" "$OPTARG"; PARENT="$OPTARG" ;;
        *) OPTION="invalid"; break ;;
    esac
done
shift "$((OPTIND -1))"

if [ "$OPTION" = "invalid" ] || [ $# -lt 3 ]
then
    exec 1>&2
    _restsh.help.desc.get "$0"
    echo "Usage: $(basename "$0") [options...] <name> <rd number> <partition> [<vlan> ...]"
    echo "Options:"
    echo "    -n             Disable strict isolation"
    echo "    -p <fullPath>  Parent Route Domain"
    exit 2
fi

restsh.util.check.string "Name" "$2"; NAME=$1
restsh.util.check.uint "RD Number" "$2"; RDNUM=$2
restsh.util.check.string "Partition" "$3"; PARTITION=$3
shift 3

VLANS=$(printf "%s\n" "$@" | JQ -Rn '[inputs]')

JQ -n --arg fullpath "/${PARTITION}/${NAME}" \
    --arg name "$NAME" \
    --argjson rdnum "$RDNUM" \
    --arg partition "$PARTITION" \
    --arg strict "$STRICT" \
    --arg parent "$PARENT" \
    --argjson vlans "$VLANS" \
    '{
        fullPath: $fullpath,
        name: $name,
        partition: $partition,
        id: $rdnum,
        strict: $strict,
        parent: $parent,
        vlans: $vlans
    }' | POST "/mgmt/tm/net/route-domain/"
