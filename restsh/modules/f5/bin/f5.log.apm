# Shortdesc: Fetches last lines from APM log.
# Desc:
# Fetches last lines from APM log.

# Strict error handling
set -eEu -o pipefail

# Debug mode
[ -n "${RESTSH_DEBUG+x}" ] && set -x

if [ -z "${RESTSH_PATH+x}" ]
then
  echo "Script must be run in the restsh environment."
  exit 1
fi

# Get options
while getopts ':' OPTION
do
    case "$OPTION" in
        *) OPTION="invalid"; break ;;
    esac
done
shift "$((OPTIND -1))"

if [ "$OPTION" = "invalid" ]
then
    exec 1>&2
    _restsh.help.desc.get "$0"
    echo "Usage: $(basename "$0") [options...] [lines]"
    exit 2
fi

if [ -n "${1:-}" ]
then
    restsh.util.check.uint "lines" "$1"; LINES=$1
else
    LINES=20
fi

f5.run "tail" "-${LINES}" "/var/log/apm"
