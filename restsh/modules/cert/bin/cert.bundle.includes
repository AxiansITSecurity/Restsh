# https://github.com/AxiansITSecurity/Restsh

# Shortdesc: Checks if certificates are included in a bundle by SHA1 fingerprint.
# Desc:
# Checks if certificates are included in a bundle by SHA1 fingerprint.

# Strict error handling
set -eEu -o pipefail

# Debug mode
[ -n "${RESTSH_DEBUG+x}" ] && set -x

if [ -z "${RESTSH_PATH+x}" ]
then
    echo "Script must be run in the restsh environment."
    exit 1
fi

FAIL_INCLUDED=0
FAIL_EXCLUDED=0
while getopts ':ehi' OPTION
do
    case "$OPTION" in
        i) FAIL_INCLUDED=1 ;;
        e) FAIL_EXCLUDED=1 ;;
        *) OPTION="invalid"; break ;;
    esac
done
shift "$((OPTIND -1))"

if [ "$OPTION" = "invalid" ] || [ $# -ne 2 ]
then
    exec 1>&2
    _restsh.help.desc.get "$0"
    echo "Usage: $(basename "$0") <bundle file> <check file>"
    echo "Options:"
    echo "    -e  Fail if certificate is not in bundle"
    echo "    -i  Fail if certificate is in bundle"
    exit 2
fi

restsh.util.check.filename "bundle file" "$1"; BUNDLE_FILE=$1
restsh.util.check.filename "check file" "$2"; CHECK_FILE=$2

declare -A BUNDLE
while read -r LINE
do
    KEY=${LINE%%=*}
    VALUE=${LINE#*=}
    if [ "$KEY" = "SHA1 Fingerprint" ]
    then
        LAST_FP="$VALUE"
    else
        BUNDLE["$LAST_FP"]=$VALUE
    fi
done < <(openssl x509 -multi -in "$BUNDLE_FILE" -noout -fingerprint -subject)

RC=0
while read -r LINE
do
    KEY=${LINE%%=*}
    VALUE=${LINE#*=}
    if [ "$KEY" = "subject" ]
    then
        LAST_SUBJECT="$VALUE"
    else
        INCLUDED="${BUNDLE["$VALUE"]:-}"
        if [ -n  "$INCLUDED" ]
        then
            if [ "$FAIL_INCLUDED" -eq 1 ]
            then
                 echo_err "Included:     $LAST_SUBJECT"
                 RC=1
            else
                echo "Included:     $LAST_SUBJECT"
            fi
        else
            if [ "$FAIL_EXCLUDED" -eq 1 ]
            then
                echo_err "Not included: $LAST_SUBJECT"
                RC=1
            else
                echo "Not included: $LAST_SUBJECT"
            fi
        fi
    fi
done < <(openssl x509 -multi -in "$CHECK_FILE" -noout -subject -fingerprint)

exit "$RC"
